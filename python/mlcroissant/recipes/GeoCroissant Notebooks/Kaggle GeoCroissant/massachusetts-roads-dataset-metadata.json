  "@type": "sc:Dataset",
  "name": "massachusetts-roads-dataset",
  "description": "High-quality aerial imagery dataset for road segmentation covering urban, suburban, and rural areas across Massachusetts. Contains 1,171 aerial images of 1500x1500 pixels at 1 meter per pixel resolution, paired with rasterized road centerlines from OpenStreetMap.",
  "conformsTo": [
    "http://mlcommons.org/croissant/1.1",
    "http://mlcommons.org/croissant/geo/"
  ],
  "citeAs": "@phdthesis{MnihThesis,\n    author = {Volodymyr Mnih},\n    title = {Machine Learning for Aerial Image Labeling},\n    school = {University of Toronto},\n    year = {2013}}",
  "datePublished": "2020-09-26",
  "geocr:bandConfiguration": {
    "@type": "geocr:BandConfiguration",
    "geocr:bandNamesList": [
      "Red",
      "Green",
      "Blue"
    ],
    "geocr:totalBands": 3
  },
  "geocr:coordinateReferenceSystem": "EPSG:26986",
  "geocr:samplingStrategy": "1500x1500 aerial tiles covering 2.25 square kilometers each, rescaled to 1 pixel per square meter.",
  "geocr:spatialBias": "Concentrated over Massachusetts, USA covering over 2,600 square kilometers across urban, suburban, and rural regions.",
  "geocr:spatialResolution": {
    "@type": "sc:QuantitativeValue",
    "unitText": "m",
    "value": 1.0
  },
  "geocr:spectralBandMetadata": [
    {
      "@type": "geocr:SpectralBand",
      "name": "Red",
      "geocr:bandwidth": {
        "@type": "sc:QuantitativeValue",
        "unitText": "nm",
        "value": 100
      },
      "geocr:centerWavelength": {
        "@type": "sc:QuantitativeValue",
        "unitText": "nm",
        "value": 650
      }
    },
    {
      "@type": "geocr:SpectralBand",
      "name": "Green",
